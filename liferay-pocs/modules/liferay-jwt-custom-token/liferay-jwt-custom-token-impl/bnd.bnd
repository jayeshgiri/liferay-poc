Bundle-Name: liferay-jwt-custom-token-impl
Bundle-SymbolicName: liferay.jwt.custom.token.impl
Bundle-Version: 1.0.0
-fixupmessages "Classes found in the wrong directory"; restrict: =error; is:=warning
Import-Package:\
	!com.google.crypto.tink.*,\
	\
			!net.shibboleth.utilities.*,\
	\
			!org.bouncycastle.*,\
	\
			!org.cryptomator.siv.*,\
	\
			!org.joda.time.*,\
	\
			!org.opensaml.*,\
	\
			*